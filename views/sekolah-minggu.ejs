<%- public_head("Sekolah Minggu — GPI Cipayung", s) %>
<body class="team-page organization-page sekolah-minggu-page">
<%- public_header(s, 'pelayanan') %>
<header class="page-hero team-hero"><div class="container">
  <div><span class="label">Pelayanan Anak</span><h1>Sekolah Minggu</h1><p>Pelayanan pembinaan iman anak dan generasi muda sejak dini di lingkungan GPI Cipayung.</p></div>
