<%- public_head("Media — GPI Cipayung", s) %>
<body>
<%- public_header(s, 'media') %>
<main id="main-content" class="social-page">
<header class="social-hero"><div class="container"><span class="eyebrow">GPI Cipayung · Media</span><h1>Faith. Life. Stories.</h1><p>Firman Tuhan, momen ibadah, dan cerita dari keluarga rohani kita.</p></div></header>
<div class="container social-tabs-wrap"><nav class="social-tabs" aria-label="Jenis media" role="tablist"><button id="tab-youtube" role="tab" aria-controls="panel-youtube" aria-selected="true" data-social-tab="youtube">YouTube</button><button id="tab-instagram" role="tab" aria-controls="panel-instagram" aria-selected="false" data-social-tab="instagram">Instagram</button><button id="tab-galeri" role="tab" aria-controls="panel-galeri" aria-selected="false" data-social-tab="galeri">Galeri Gereja</button></nav></div>
<section id="panel-youtube" role="tabpanel" aria-labelledby="tab-youtube" class="social-panel">
<div class="youtube-feature"><div class="container"><div class="social-feature-heading"><div><span class="eyebrow">GPI Sidang Cipayung</span><h2>Saksikan &amp; bertumbuh.</h2><p>Video ibadah, khotbah dan pelayanan terbaru dari kanal YouTube kami.</p></div><a class="refresh-button light" href="https://www.youtube.com/@gpisidangcipayung" target="_blank" rel="noopener noreferrer">Buka YouTube ↗</a></div><div id="youtubeFeature" class="youtube-feature-grid"><p class="social-status">Memuat video terbaru…</p></div></div></div>
<div class="container social-library"><div class="social-section-heading"><div><span class="eyebrow">Koleksi video</span><h2>Konten terbaru</h2></div><label class="social-search"><span class="sr-only">Cari video</span><input type="search" id="youtubeSearch" placeholder="Cari judul video…"></label></div><p id="youtubeStatus" class="social-status" role="status"></p><div id="youtubeGrid" class="youtube-grid"></div><a class="social-all" href="https://www.youtube.com/@gpisidangcipayung/videos" target="_blank" rel="noopener noreferrer">Lihat semua video di YouTube ↗</a></div>
</section>
<section id="panel-instagram" role="tabpanel" aria-labelledby="tab-instagram" class="social-panel" hidden>
<div class="instagram-feature"><div class="container instagram-hero-grid"><div class="ig-device" aria-hidden="true"><div class="ig-device-top"><span>Instagram</span><b>•••</b></div><img src="<%- pv_esc(pv_logo(s)) %>" alt=""><strong>@gpicipayung</strong><small>GPI Cipayung</small><div class="ig-device-lines"><span></span><span></span><span></span></div><div class="ig-device-photo"></div></div><div><span class="eyebrow">Tetap terhubung</span><h2>Ikuti Instagram kami.</h2><p>Temukan warta, dokumentasi, dan momen pelayanan GPI Cipayung setiap minggu.</p><a class="refresh-button light" href="https://www.instagram.com/gpicipayung/" target="_blank" rel="noopener noreferrer">Ikuti @gpicipayung ↗</a></div></div></div>
<div class="container social-library"><div class="ig-profile"><div class="ig-profile-header"><img src="<%- pv_esc(pv_logo(s)) %>" alt="Logo GPI Cipayung"><div><h3>@gpicipayung</h3><p>GPI Cipayung · Akun resmi gereja</p><a href="https://www.instagram.com/gpicipayung/" target="_blank" rel="noopener noreferrer">Lihat profil Instagram ↗</a></div></div><p id="instagramStatus" class="social-status" role="status">Memuat postingan…</p><div id="instagramGrid" class="instagram-grid"></div></div></div>
</section>
<section id="panel-galeri" role="tabpanel" aria-labelledby="tab-galeri" class="social-panel" hidden><div class="container social-library"><div class="social-section-heading"><div><span class="eyebrow">Dokumentasi resmi</span><h2>Galeri Ibadah &amp; Pelayanan</h2><p>Album foto dan video yang dipublikasikan melalui dashboard gereja.</p></div><div class="media-toolbar media-toolbar-clean"><input id="mediaSearch" type="search" placeholder="Cari media…" aria-label="Cari media"></div></div><div id="mediaGrid" class="media-album-list"><%- render_media(data['media']) %></div></div></section>
</main>
<%- public_footer(s) %>
