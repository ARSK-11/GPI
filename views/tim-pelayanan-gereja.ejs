<%- public_head("Tim Pelayanan Gereja — GPI Cipayung", s) %>
<body class="team-page team-service-page">
<%- public_header(s, 'pelayanan') %>

<header class="page-hero team-hero"><div class="container">
  <div>
    <span class="label">Struktur Pelayanan</span>
    <h1>Tim Pelayanan Gereja</h1>
    <p>Struktur pelayanan GPI Cipayung yang mendukung penggembalaan, pelayanan jemaat, diakonia, dan media gereja dalam semangat melayani Tuhan.</p>
  </div>
  <img data-logo-gereja src="<%- pv_esc(pv_logo(s)) %>" alt="Logo <%- pv_esc(s['nama_gereja']) %>">
</div></header>

<div class="breadcrumb-row"><div class="container"><a href="/">Beranda</a> / <a href="pelayanan">Pelayanan</a> / Tim Pelayanan Gereja</div></div>

<section class="section org-section"><div class="container">
  <div class="section-center"><span class="label">Majelis &amp; Pelayan Gereja</span><h2>Struktur Organisasi Pelayanan</h2><div class="divider"></div>
    <p class="lead">Susunan pelayan gereja yang terlibat dalam penggembalaan, pelayanan jemaat, dan pengelolaan pelayanan gereja.</p></div>
  <div class="org-block primary"><h3 class="org-title">Gembala Sidang</h3>
    <div id="gembalaGrid" class="profile-grid org-grid one"><%- team['gembala'] %></div></div>
  <div class="org-block"><h3 class="org-title">Hamba Tuhan &amp; Pelayan Gereja</h3>
    <div id="pelayanGerejaGrid" class="profile-grid org-grid centered"><%- team['pelayanGereja'] %></div></div>
</div></section>

<section class="section alt diakonia-section"><div class="container">
  <div class="section-center"><span class="label">Pelayanan Kasih</span><h2>Pengurus Diakonia</h2><div class="divider"></div>
    <p class="lead">Pengurus Diakonia berperan dalam pelayanan sosial, perhatian jemaat, dan pelayanan kasih yang mendukung kebutuhan gereja.</p></div>
  <div id="diakoniaGrid" class="profile-grid org-grid diakonia-grid three"><%- team['diakonia'] %></div>
</div></section>

<section class="section dark-section media-team-section"><div class="container">
  <div class="section-center"><span class="label">Pelayanan Digital</span><h2>Pengurus Media Gereja</h2><div class="divider"></div>
    <p class="lead">Tim Media Gereja mendukung dokumentasi, publikasi, desain, konten, dan komunikasi digital pelayanan GPI Cipayung.</p></div>
  <div id="mediaTeamGrid" class="profile-grid media-team-grid"><%- team['mediaTeam'] %></div>
</div></section>

<div class="back-cta"><a class="btn" href="pelayanan">← Kembali ke Bidang Pelayanan</a></div>

<%- public_footer(s) %>
