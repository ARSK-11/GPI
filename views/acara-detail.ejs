<%- public_head(event.judul + ' — GPI Cipayung', s) %>
<body><%- public_header(s,'beranda') %><main id="main-content"><header class="refresh-page-hero"><div class="container"><span class="eyebrow">Acara kita · GPI Cipayung</span><h1><%- pv_esc(event.judul) %></h1><p><%- pv_esc(contentDate(event.tanggal_mulai,event.tanggal_selesai)) %></p></div></header><section class="refresh-section"><div class="container f4-event-detail"><% if(contentImage(event.foto_path)){ %><img src="<%- pv_esc(contentImage(event.foto_path)) %>" alt="Poster <%- pv_esc(event.judul) %>"><% } %><div><span class="eyebrow">Informasi acara</span><h2><%- pv_esc(event.judul) %></h2><p><%- pv_esc(event.deskripsi) %></p><p><strong>Lokasi:</strong> <%- pv_esc(event.lokasi||'Akan diinformasikan') %></p><a class="refresh-button" href="/terhubung">Hubungi gereja ↗</a><a class="text-link" href="/#acara">Kembali ke acara</a></div></div></section></main><%- public_footer(s) %>
