<%- public_head("Tentang GPI Cipayung", s) %>
<body>
<%- public_header(s, 'tentang') %>
<header class="page-hero compact-hero"><div class="container"><div><span class="label">Tentang Gereja</span><h1>Mengenal GPI Cipayung</h1><p>Gereja Pentakosta Indonesia Sidang Cipayung melayani jemaat melalui ibadah, penggembalaan, pelayanan sosial, dan pengajaran Firman Tuhan.</p></div><img data-logo-gereja src="<%- pv_esc(pv_logo(s)) %>" alt="Logo <%- pv_esc(s['nama_gereja']) %>"></div></header>
<div class="breadcrumb-row"><div class="container"><a href="/">Beranda</a> / Tentang</div></div>
<section class="section"><div class="container about-grid"><div class="about-logo-card"><img data-logo-gereja src="<%- pv_esc(pv_logo(s)) %>" alt="Logo <%- pv_esc(s['nama_gereja']) %>"></div><div class="about-copy"><span class="label">Profil Gereja</span><h2>Rumah rohani bagi jemaat Cipayung dan sekitarnya.</h2><p class="lead">Website ini menjadi wajah digital resmi GPI Cipayung untuk memperkenalkan profil gereja, jadwal ibadah, kegiatan pelayanan, pengumuman, dan dokumentasi gereja kepada jemaat maupun masyarakat umum.</p><p class="lead">Sistem publik ini terhubung dengan dashboard internal sehingga informasi yang tampil dapat diperbarui oleh admin, majelis/pengurus, dan pendeta sesuai hak akses masing-masing.</p></div></div></section>
<section class="section alt"><div class="container"><div class="section-center"><span class="label">Ringkasan Data</span><h2>Informasi yang Terpublikasi</h2><div class="divider"></div></div><div class="mini-stats about-stat-row"><div><b><%- st['jadwal'] %></b><span>Jadwal Ibadah</span></div><div><b><%- st['pengumuman'] %></b><span>Pengumuman</span></div><div><b><%- st['media'] %></b><span>Media</span></div><div><b><%- st['pelayanan'] %></b><span>Bidang Pelayanan</span></div></div></div></section>
<%- public_footer(s) %>
