<%- public_head(pv_esc(service.judul) + ' — GPI Cipayung', s) %>
<body class="f4-service-page">
<%- public_header(s, 'jadwal') %>
<main id="main-content">
<nav class="f4-service-nav" aria-label="Jenis ibadah"><a href="/jadwal-ibadah">Semua ibadah</a><% (data.ibadah_konten||[]).forEach(r=>{ %><a href="/ibadah-<%- pv_esc(r.slug) %>" <%- service.slug===r.slug?'aria-current="page"':'' %>><%- pv_esc(r.judul) %></a><% }); %></nav>
<header class="f4-service-hero"><% if(contentImage(service.hero_path)){ %><img src="<%- pv_esc(contentImage(service.hero_path)) %>" alt="" aria-hidden="true"><% } %><div class="container"><span class="eyebrow">GPI CIPAYUNG · IBADAH</span><h1><%- pv_esc(service.judul) %></h1></div></header>
<div class="f4-marquee f4-marquee-service" data-marquee><div class="f4-marquee-track"><% for(let j=0;j<2;j++){ %><div class="f4-marquee-group" <%- j?'aria-hidden="true"':'' %>><% for(let i=0;i<4;i++){ %><span><%- pv_esc(service.judul.toUpperCase()) %> <b aria-hidden="true">—</b></span><% } %></div><% } %></div><button type="button" class="f4-motion-toggle" aria-label="Jeda animasi tulisan" aria-pressed="false">Ⅱ</button></div>
<section class="f4-service-intro"><div class="container f4-editorial"><div><span class="eyebrow">Bersama dalam iman</span><h2><%- pv_esc(service.judul) %></h2></div><p><%- pv_esc(service.deskripsi) %></p></div></section>
<% if(service.nama_pembina||service.bio){ %><section class="f4-leader"><div class="f4-leader-photo"><% if(contentImage(service.foto_path)){ %><img src="<%- pv_esc(contentImage(service.foto_path)) %>" alt="<%- pv_esc(service.nama_pembina) %>" loading="lazy"><% }else{ %><div class="f4-leader-placeholder"><%- pv_esc(service.jabatan_pembina||'Pelayan Tuhan') %></div><% } %></div><div class="f4-leader-copy"><span class="eyebrow"><%- pv_esc(service.jabatan_pembina) %></span><h2><%- pv_esc(service.nama_pembina) %></h2><p><%- pv_esc(service.bio) %></p></div></section><% } %>
<section class="refresh-section"><div class="container"><div class="refresh-section-head"><div><span class="eyebrow">Mari datang dan beribadah</span><h2>Waktu ibadah.</h2></div></div><div class="f4-time-panel"><div><span class="eyebrow">Lokasi ibadah</span><h3><%- pv_esc(service.lokasi||s.nama_gereja) %></h3><p><%- pv_esc(s.alamat_gereja) %></p><a class="refresh-button" target="_blank" rel="noopener noreferrer" href="https://www.google.com/maps/search/?api=1&query=<%- encodeURIComponent(s.alamat_gereja||'GPI Cipayung') %>">Lihat lokasi ↗</a></div><div><span class="eyebrow">Jadwal rutin</span><h3><%- pv_esc(service.judul) %></h3><p class="f4-schedule"><%- pv_esc(service.jadwal||'Jadwal akan diinformasikan oleh pengurus gereja.') %></p><a class="refresh-button outline" href="/terhubung">Hubungi gereja ↗</a></div></div></div></section>
<section class="refresh-section news-section"><div class="container"><div class="refresh-section-head"><div><span class="eyebrow">Informasi terkini</span><h2>Jadwal pelayanan.</h2></div><a class="text-link" href="/jadwal-ibadah#jadwal">Semua jadwal ↗</a></div><div class="schedule-list"><%- render_jadwal((data.jadwal||[]).filter(r=>{const name=String(r.jenis_ibadah||'').toLowerCase();return name.includes(service.judul.toLowerCase().replace(/^ibadah /,'')) || (service.slug==='youth-revive-generation'&&/youth|revive|pemuda/.test(name));})) %></div></div></section>

<% if(typeof serviceDocs!=='undefined'&&serviceDocs.length){ %>
<section class="service-docs refresh-section" id="dokumentasi" aria-labelledby="docs-heading">
  <div class="container">
    <div class="service-docs-heading"><div><span class="eyebrow">DOKUMENTASI IBADAH</span><h2 id="docs-heading">Momen kebersamaan.</h2><p>Kenangan pelayanan dan persekutuan <%- pv_esc(service.judul) %> melalui foto, video, dan dokumen.</p></div><span class="service-docs-count"><%- serviceDocs.length %> koleksi</span></div>
    <% const singleDocs=serviceDocs.filter(x=>x.source!=='drive_folder'); const folderDocs=serviceDocs.filter(x=>x.source==='drive_folder'); %>
    <% if(singleDocs.length){ %>
    <div class="service-docs-filters" role="group" aria-label="Filter dokumentasi">
      <button type="button" data-doc-filter="all" aria-pressed="true" class="is-active">Semua</button>
      <button type="button" data-doc-filter="photo" aria-pressed="false">Foto</button>
      <button type="button" data-doc-filter="video" aria-pressed="false">Video</button>
      <button type="button" data-doc-filter="pdf" aria-pressed="false">PDF</button>
    </div>
    <div class="service-docs-grid" data-doc-grid>
     <% singleDocs.forEach(r=>{const src=docs.previewSrc(r),thumb=docs.imageSrc(r); %>
      <article class="service-doc-card" data-doc-type="<%- pv_esc(r.media_type) %>">
       <div class="service-doc-media">
        <% if(r.media_type==='photo'&&thumb){ %><a href="<%- pv_esc(r.source==='drive_file'?r.external_url:src) %>" target="_blank" rel="noopener noreferrer" aria-label="Lihat foto <%- pv_esc(r.judul) %>"><img src="<%- pv_esc(thumb) %>" alt="<%- pv_esc(r.judul) %>" loading="lazy"></a>
        <% }else if(r.media_type==='video'&&r.source==='upload'&&src){ %><video src="<%- pv_esc(src) %>" controls preload="metadata" playsinline aria-label="<%- pv_esc(r.judul) %>"></video>
        <% }else if(r.media_type==='video'&&r.source==='drive_file'&&src){ %><iframe src="<%- pv_esc(src) %>" title="Video: <%- pv_esc(r.judul) %>" loading="lazy" allow="autoplay; fullscreen" allowfullscreen></iframe>
        <% }else{ %><a class="service-doc-pdf" href="<%- pv_esc(r.source==='drive_file'?r.external_url:src) %>" rel="noopener noreferrer" target="_blank"><span aria-hidden="true">PDF</span><strong>Lihat dokumen ↗</strong></a><% } %>
       </div>
       <div class="service-doc-info"><span><%- r.media_type==='photo'?'FOTO':r.media_type==='video'?'VIDEO':'DOKUMEN PDF' %> · <%- r.source==='upload'?'UPLOAD GEREJA':'GOOGLE DRIVE' %></span><h3><%- pv_esc(r.judul) %></h3><% if(r.deskripsi){ %><p><%- pv_esc(r.deskripsi) %></p><% } %><% if(src){ %><a class="service-doc-open" href="<%- pv_esc(r.source==='drive_file'?r.external_url:src) %>" target="_blank" rel="noopener noreferrer">Buka dokumentasi ↗</a><% } %></div>
      </article>
     <% }); %>
    </div>
    <% } %>
    <% folderDocs.forEach(r=>{ %>
     <section class="service-drive-section" aria-label="<%- pv_esc(r.judul) %>">
      <div class="service-drive-heading"><div><span class="eyebrow">ALBUM GOOGLE DRIVE</span><h3><%- pv_esc(r.judul) %></h3><p><%- pv_esc(r.deskripsi) %></p></div><a href="<%- pv_esc(r.external_url) %>" class="refresh-button outline" target="_blank" rel="noopener noreferrer">Buka Google Drive ↗</a></div>
      <div data-drive-album="<%- Number(r.id) %>" class="service-drive-album"><div class="service-drive-native" hidden></div><div class="service-drive-embed"><iframe loading="lazy" src="<%- pv_esc(docs.previewSrc(r)) %>" title="Album Drive <%- pv_esc(r.judul) %>" referrerpolicy="strict-origin-when-cross-origin"></iframe><p>Jika album tidak terlihat, gunakan tombol <strong>Buka Google Drive</strong>. Pastikan izin folder sudah disetel ke <strong>Siapa saja yang memiliki link — Pelihat</strong>.</p></div></div>
     </section>
    <% }); %>
  </div>
</section>
<% } %>
<script src="/assets/js/website-docs.js?v=5" defer></script>
</main><%- public_footer(s) %>
