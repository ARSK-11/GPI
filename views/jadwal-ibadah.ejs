<%- public_head("Ibadah — GPI Cipayung", s) %>
<body class="f4-service-page"><%- public_header(s,'jadwal') %><main id="main-content">
<nav class="f4-service-nav" aria-label="Jenis ibadah"><a href="/jadwal-ibadah" aria-current="page">Semua ibadah</a><% (data.ibadah_konten||[]).forEach(r=>{ %><a href="/ibadah-<%- pv_esc(r.slug) %>"><%- pv_esc(r.judul) %></a><% }); %></nav>
<header class="f4-service-hero"><img src="/assets/img/cover-ibadah-gpi-cipayung.jpeg" alt="" aria-hidden="true"><div class="container"><span class="eyebrow">GPI CIPAYUNG · IBADAH</span><h1>Worship together.</h1><p>Temukan waktu untuk beribadah, berdoa, dan bertumbuh bersama keluarga rohani.</p></div></header>
<div class="f4-marquee f4-marquee-service" data-marquee><div class="f4-marquee-track"><% for(let j=0;j<2;j++){ %><div class="f4-marquee-group" <%- j?'aria-hidden="true"':'' %>><% for(let i=0;i<4;i++){ %><span>BERIBADAH BERSAMA <b aria-hidden="true">—</b></span><% } %></div><% } %></div><button class="f4-motion-toggle" type="button" aria-label="Jeda animasi tulisan" aria-pressed="false">Ⅱ</button></div>
<section class="refresh-section"><div class="container"><div class="refresh-section-head"><div><span class="eyebrow">Untuk setiap generasi</span><h2>Temukan ibadahmu.</h2></div></div><div class="f4-service-grid"><% (data.ibadah_konten||[]).forEach((r,i)=>{ %><a class="f4-service-card" href="/ibadah-<%- pv_esc(r.slug) %>"><span class="eyebrow">0<%- i+1 %> · IBADAH</span><h3><%- pv_esc(r.judul) %></h3><p><%- pv_esc(r.jadwal||'Lihat informasi ibadah') %></p><span class="f4-card-arrow" aria-hidden="true">↗</span></a><% }); %><% if(!(data.ibadah_konten||[]).length){ %><p>Konten ibadah belum tersedia. Silakan hubungi gereja.</p><% } %></div></div></section>
<section class="refresh-section news-section" id="jadwal"><div class="container"><div class="refresh-section-head"><div><span class="eyebrow">Jadwal terpublikasi</span><h2>Waktu ibadah.</h2></div></div><div id="jadwalList" class="schedule-list"><%- render_jadwal(data.jadwal) %></div></div></section>
<section class="refresh-section" id="doa-pagi"><div class="container worship-grid"><%- prayerCard() %><div class="prayer-description"><span class="eyebrow">Persekutuan doa online</span><h2>Awali hari bersama Tuhan.</h2><p>Ikuti Doa Pagi melalui Google Meet setiap Sabtu pukul 05.00 WIB.</p><a class="text-link" href="/doa-pagi">Informasi Doa Pagi ↗</a></div></div></section>
</main><%- public_footer(s) %>
