# Variabel untuk Vercel -> Project -> Settings -> Environment Variables.
# Salin satu per satu ke dashboard Vercel atau lewat `npx vercel env add`.
# Jangan commit file .env asli. File ini hanya contoh.

# Wajib: Vercel memasang NODE_ENV=production otomatis, dan server.js
# menghentikan proses bila SESSION_SECRET kosong (penyebab 500 FUNCTION_INVOCATION_FAILED).
NODE_ENV=production
SESSION_SECRET=ganti-dengan-string-acak-minimal-32-karakter

# Wajib: MySQL eksternal. `localhost` tidak bisa dipakai di Vercel.
# Isi dari dashboard provider database (Aiven / PlanetScale / TiDB Cloud / Railway).
DB_HOST=mysql-xxxx.aivencloud.com
DB_PORT=3306
DB_NAME=gpi_cipayung
DB_USER=avnadmin
DB_PASSWORD=ganti-dengan-password-database
# Set 1 bila provider mewajibkan TLS (Aiven, PlanetScale, TiDB Cloud, Railway).
DB_SSL=1

# Bot WhatsApp Web dan reminder otomatis tidak bisa berjalan di Vercel.
WA_REMINDER_AUTO=0
