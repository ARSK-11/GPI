PORT=3000
NODE_ENV=development
DB_HOST=localhost
DB_PORT=3306
DB_NAME=gpi_cipayung
DB_USER=root
DB_PASSWORD=
# Set 1 bila MySQL eksternal mewajibkan TLS (Aiven, PlanetScale, TiDB Cloud, Railway).
DB_SSL=0
SESSION_SECRET=
WHATSAPP_GROUP_INVITE=

# Bot WhatsApp Web (whatsapp-web.js). Instal dependensi bot: npm install --prefix app
# Path browser opsional; sesi bot sebaiknya disimpan di luar folder publik dan Git.
WA_LINKED_BROWSER_PATH=
WA_LINKED_SESSION_DIR=
# Set 1 hanya jika Chrome gagal start di container (melemahkan sandbox browser).
WA_LINKED_NO_SANDBOX=0
# Pin build WhatsApp Web yang kompatibel. Kosongkan cache dir untuk memakai arsip remote.
WA_WEB_VERSION=2.3000.1053021455-alpha
WA_LINKED_WEB_CACHE_DIR=
# Reminder H-1 otomatis dari server setiap hari (jam WIB). Set 0 untuk mematikan.
WA_REMINDER_AUTO=1
WA_REMINDER_HOUR=8

# Meta Cloud API hanya untuk modul renungan/broadcast (bukan bot jadwal).
WA_CLOUD_PHONE_NUMBER_ID=
WA_CLOUD_TOKEN=
WA_GRAPH_VERSION=v19.0

# Link rapat Google Meet resmi Doa Pagi
DOA_PAGI_MEET_URL=https://meet.google.com/ywm-oere-smt

# Media sosial (YouTube feed tanpa API key; key opsional untuk lebih banyak unggahan)
YOUTUBE_CHANNEL_ID=UCiiGg_Nt5UtRixE99FwSoYQ
YOUTUBE_API_KEY=
# Instagram: akun profesional yang telah mengotorisasi Instagram Login
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_GRAPH_VERSION=v27.0
# Alternatif manual: URL postingan/reels resmi, dipisahkan koma
INSTAGRAM_POST_URLS=

# Opsional: Google Drive API key untuk menampilkan file dalam grid otomatis.
# Tanpa key, album Google Drive tetap tampil sebagai folder tersemat.
DRIVE_API_KEY=
