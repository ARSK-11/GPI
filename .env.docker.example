# Konfigurasi Docker. Salin menjadi .env.docker atau jalankan `npm run docker:deploy`
# yang membuat file ini otomatis dengan password dan SESSION_SECRET acak.
#
# Password root MariaDB dan password database aplikasi harus sama.
MARIADB_ROOT_PASSWORD=ganti-password-db
DB_ROOT_PASSWORD=ganti-password-db
DB_PASSWORD=ganti-password-db
DB_NAME=gpi_cipayung

# Wajib diisi pada produksi; minimal 32 karakter acak.
SESSION_SECRET=ganti-dengan-secret-acak-minimal-32-karakter

# 1 = cookie hanya dikirim lewat HTTPS (pakai bila sudah di belakang reverse proxy TLS).
# 0 = izinkan login lewat HTTP langsung (mis. http://localhost:3000 atau IP LAN).
SESSION_COOKIE_SECURE=0

# Reminder H-1 otomatis (jam WIB) dan pin versi WhatsApp Web.
WA_REMINDER_AUTO=1
WA_REMINDER_HOUR=8
WA_WEB_VERSION=2.3000.1053021455-alpha

# Opsional
# WA_LINKED_BROWSER_PATH=
# WA_CLOUD_PHONE_NUMBER_ID=
# WA_CLOUD_TOKEN=
# YOUTUBE_API_KEY=
# INSTAGRAM_USER_ID=
# INSTAGRAM_ACCESS_TOKEN=
# DRIVE_API_KEY=
